<!DOCTYPE html>
<html>
<head>
  <meta charset="utf-8">
  <title>Edit Student</title>
  <link rel="stylesheet" href="/editStudent.css">
</head>
<body>
  <div class="form-card">
    <h2>Edit : <%= student ? student.name : "" %></h2>
    <% if (student) { %>
      <form action="/students/edit/<%= student.student_id %>" method="POST" class="grid">
        <input name="name" value="<%= student.name %>" required>
        <input name="roll_no" value="<%= student.roll_no %>">
        <input name="course" value="<%= student.course %>">
        <input name="year" value="<%= student.year %>">
        <input name="section" value="<%= student.section %>">
        <input name="email" value="<%= student.email %>">
        <input name="phone" value="<%= student.phone %>">
        <input name="address" value="<%= student.address %>">
        <label><input type="checkbox" name="library_fee_paid" <%= student.library_fee_paid ? "checked" : "" %>>Fee Paid</label>
        <input name="library_fee_amount" value="<%= student.library_fee_amount || 0 %>">
        <br>
        <div class="full"><button class="btn-primary" type="submit"><center>&star;Update</center></button></div>
     
      </form>
    <% } else { %>
      <p>Student not found.</p>
    <% } %>
    <br><br>
<center>
  <a href="/students" class="back-btn">⬅ BACK</a>
</center>

  </div>
</body>
</html>
